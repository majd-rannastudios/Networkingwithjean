# Port the server listens on (Railway injects this automatically)
PORT=3000

# PIN for the operator/admin console. CHANGE THIS before any real event.
ADMIN_PIN=1234

# Public URL the QR code should point at, e.g. https://networking.rannastudios.com
# Leave blank locally and the server will use the request host.
PUBLIC_URL=

# Optional. If set, event state is persisted here and survives a restart/redeploy.
# Railway: add a Postgres service and this is injected for you.
DATABASE_URL=
